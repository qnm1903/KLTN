PORT=3001
FRONTEND_URL=http://localhost:5173
# For WebSocket listener, use wss:// URL instead of https://
RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY
WS_RPC_URL=wss://sepolia.infura.io/v3/YOUR_API_KEY
CHAIN_ID=11155111
FACTORY_ADDRESS=0xYourFactoryContractAddress
MEDIATOR_POOL_CONTRACT=0xYourMediatorPoolProxyAddress
LISTENER_CONFIRMATIONS=6
LISTENER_POLL_INTERVAL_MS=12000
LISTENER_BLOCK_BATCH_SIZE=1000
LISTENER_START_BLOCK=10491707
ENFORCE_ESCROW_STATUS_TRANSITIONS=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_NONCE_MAX=20
RATE_LIMIT_AUTH_VERIFY_MAX=15
RATE_LIMIT_ESCROW_INIT_MAX=10
RATE_LIMIT_ESCROW_SIGN_MAX=20
RATE_LIMIT_ESCROW_PUBKEY_SUBMIT_MAX=60
DATABASE_URL=YOUR_DATABASE_URL
# If use Torso Cloud Database, uncomment the line below
# TORSO_AUTH_TOKEN=TOKEN_FOR_TORSO_CLOUD_DATABASE_AUTH
NODE_ENV=development
REFRESH_TOKEN_TTL_MS=604800000
PINATA_JWT=your_pinata_jwt_here
PINATA_GATEWAY_HOST=gateway.pinata.cloud
ADMIN_PRIVATE_KEY=your_admin_private_key_here