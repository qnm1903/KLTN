// Prisma Schema — Escrow TSS DApp
// SQLite cho dev/demo, dễ dàng chuyển sang Postgres cho production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  name          String?
  role          String   @default("USER") // USER | MEDIATOR | ADMIN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  boughtEscrows   Escrow[]   @relation("BuyerEscrows")
  soldEscrows     Escrow[]   @relation("SellerEscrows")
  mediatedEscrows Escrow[]   @relation("MediatorEscrows")
  evidences       Evidence[]
  statusHistoryActions EscrowStatusHistory[]
  refreshTokens   RefreshToken[]
}

model Escrow {
  id              String   @id @default(uuid())
  chainEscrowId   String?  // bytes32 ID trên Smart Contract (set sau khi deploy on-chain)
  contractAddress String?  // Địa chỉ EscrowVault contract đã deploy
  title           String
  description     String   @default("")
  amount          Decimal   // Số ETH ký quỹ (wei precision: 10^18 decimals)
  status          String   @default("DRAFT") // DRAFT | INITIALIZED | LOCKED | DISPUTED | RELEASED | REFUNDED
  disputePhase    String?  // OPENED | EVIDENCE_WINDOW | REVIEW_WINDOW | DECISION_PENDING | RESOLVED
  
  // Deadlines cho timeout check
  confirmDeadline   DateTime?  // Hạn cuối user phải confirm giao dịch (optional)
  timeoutDeadline   DateTime?  // Hạn cuối trước khi tự động dispute (optional)
  disputeOpenedAt   DateTime?
  evidenceDeadlineAt DateTime?
  reviewDeadlineAt   DateTime?
  decisionDeadlineAt DateTime?

  // Các bên tham gia
  buyerId    String
  sellerId   String
  mediatorId String

  buyer    User @relation("BuyerEscrows", fields: [buyerId], references: [id])
  seller   User @relation("SellerEscrows", fields: [sellerId], references: [id])
  mediator User @relation("MediatorEscrows", fields: [mediatorId], references: [id])

  // PKAgg data (lưu kết quả DKG để reference)
  pkAggBsX String?
  pkAggBsY String?
  pkAggBmX String?
  pkAggBmY String?
  pkAggSmX String?
  pkAggSmY String?

  evidences      Evidence[]
  statusHistory  EscrowStatusHistory[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Indices for cron job queries
  @@index([status, timeoutDeadline])
  @@index([status, confirmDeadline])
  @@index([status, disputePhase])
  @@index([disputePhase, evidenceDeadlineAt])
  @@index([disputePhase, reviewDeadlineAt])
  @@index([disputePhase, decisionDeadlineAt])
}

model Evidence {
  id          String   @id @default(uuid())
  escrowId    String
  uploaderId  String
  fileUrl     String   // Đường dẫn file upload
  description String   @default("")
  createdAt   DateTime @default(now())

  escrow   Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id])

  @@index([escrowId])
}

model EventSyncState {
  key                String   @id
  lastProcessedBlock Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProcessedChainEvent {
  id              String   @id @default(uuid())
  txHash          String
  logIndex        Int
  contractAddress String
  eventName       String
  escrowId        String?
  blockNumber     Int
  processedAt     DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([escrowId])
}

model AuthNonce {
  address   String   @id
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model EscrowStatusHistory {
  id          String   @id @default(uuid())
  escrowId    String
  actorUserId String?
  source      String   // API | CRON_TIMEOUT | EVENT_LISTENER
  fromStatus  String
  toStatus    String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([escrowId, createdAt])
  @@index([source, createdAt])
}

model SigningSession {
  id        String   @id @default(uuid())
  escrowId  String   @unique
  payload   Json
  status    String   @default("ACTIVE") // ACTIVE | EXPIRED | COMPLETED
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
}
